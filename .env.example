# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Web3Forms Access Key — powers the enrollment form on /contact.
# Get your key from https://web3forms.com/
# Note: this key is public by design. It ships in the JS bundle and is visible
# to anyone who views the site. Spam protection comes from the honeypot field
# in the form, not from hiding this value.
VITE_WEB3FORMS_ACCESS_KEY=PASTE_YOUR_KEY_HERE

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get your ID from https://analytics.google.com/
# Also public by design — it is readable in any GA-enabled page.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
